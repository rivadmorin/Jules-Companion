# ==============================================================================
# Jules Companion - Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in your actual API credentials.
# Note: In VS Code / Antigravity IDE, you can also store these securely via:
# Command Palette -> Jules: Set API Key (stored in OS SecretStorage)
# ==============================================================================

# Google Jules API Key (Required for Jules Cloud Session Dispatch & Agent Integration)
# Obtain from Google Cloud Console / Jules service credentials
JULES_API_KEY=your_jules_api_key_here

# Google Gemini API Key (Optional / Required for AI-powered Visual Diff Explanations)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
