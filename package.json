{
  "name": "jules-companion",
  "version": "1.0.0",
  "description": "Google Jules CLI & REST API companion skill with 30 specialized agents",
  "main": "dist/setup.js",
  "scripts": {
    "build": "esbuild scripts/*.ts scripts/**/*.ts --outdir=dist --platform=node --format=cjs",
    "postbuild": "node dist/sync_global.js",
    "sync": "node dist/sync_global.js",
    "pretest": "npm run build",
    "setup": "node dist/setup.js",
    "registry": "node dist/generate_registry.js",
    "deploy": "node dist/deploy_session.js",
    "merge": "node dist/merge_session.js",
    "client": "node dist/jules_client.js",
    "test": "tsx --test tests/*.test.ts",
    "mcp": "node dist/mcp_server.js",
    "graft:check": "graft check",
    "graft:map": "graft map",
    "graft:blast": "graft blast",
    "graft:viz": "graft viz",
    "graft:export": "graft viz --export docs/architecture-graph --no-open",
    "sentrux:check": "sentrux check .",
    "verify": "npm test && npm run sentrux:check && npm run graft:check"
  },
  "keywords": [
    "jules",
    "google-jules",
    "agent",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  }
}
