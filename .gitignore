# ==============================================================================
# Jules Companion - Comprehensive Git Ignore
# Excludes non-system artifacts: runtime states, build bundles, caches, secrets,
# evaluation outputs, temporary scratchpads, and OS/editor junk.
# ==============================================================================

# 1. Dependencies & Package Managers
node_modules/
.pnp/
.pnp.js

# 2. Build Outputs, Compilations & Bundles
dist/
build/
out/
*.tsbuildinfo
.esbuild/

# 3. Jules Companion Runtime, Sessions & Operational State
.jules-companion/
scratch/
*.patch
*.diff
.sessions.lock
*.sessions.lock
*.lock
!package-lock.json

# 4. Generated Reviews, Reports & Evaluation Benchmark Outputs
docs/jules-reviews/*
!docs/jules-reviews/.gitkeep
docs/jules-reports/*
!docs/jules-reports/.gitkeep
evals/results.json
evals/feedback.json
evals/review.html

# 5. Testing, Code Coverage & Temporary Test Directories
coverage/
.nyc_output/
temp_*/
tmp/

# 6. AI Agent Scratchpads, Session Brain & Task Planning (Manus/Antigravity)
task_plan.md
findings.md
progress.md
.gemini/
.agents/
.claude/
.codex/
.cursor/
.cursorrules.local

# 7. Environment Variables, Local Credentials & Secrets
.env
.env.local
.env.*.local
*.env
*.pem
*.key
*.cert

# 8. Python Runtime & Cache (Evals Simulation & Grading Suite)
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/

# 9. Architectural Sensors & Context Graph Local Caches (Sentrux & Graft)
/graft/
.sentrux/cache/
.sentrux/*.cache
.sentrux/baseline.json

# 10. Logs & Debug Traces
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 11. System & OS Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*.tmp
*.bak
*.swp
*.swo
*~

# 12. IDE & Editor Workspaces
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
